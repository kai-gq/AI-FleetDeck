# Firebase (push notifications) — project-specific ids and a key that can
# push to every device of the project. Never commit these.
android/app/google-services.json
fcm-service-account.json

# Local tool installs (piper TTS engine + voice models, ~159 MB).
# Not part of the repo; friends can install their own copy or set
# PIPER_BIN / PIPER_VOICES_DIR to point elsewhere.
tools/piper/

# bolba-board runtime data (SQLite board + Markdown mirror) and local config.
tools/bolba-board/data/
tools/bolba-board/config.local.json

# ASR hotword pool (local runtime data; the curator rebuilds it from dialogue).
tools/voice-companion/hotwords.local.json

# i18n workdir (translation kits, memory) — regenerated, not source.
tools/i18n/work/
tools/wave-gate/trend.jsonl

